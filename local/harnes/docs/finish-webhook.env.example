# Copy to project .limen/finish-webhook.env (NEVER commit secrets).
# Used by bin/tony-finish-ping.sh and unit-done-notify.sh (optional).
#
# Single target:
# LIMEN_FINISH_WEBHOOK_URL=https://example.invalid/hooks/limen-finish
# LIMEN_FINISH_WEBHOOK_AUTH=Bearer REPLACE_ME
#
# Or multi-target JSON (1–64):
# LIMEN_FINISH_WEBHOOK_TARGETS=[{"url":"https://example.invalid/hooks/a","auth":"Bearer REPLACE_ME"}]
#
# Override path for callers:
# export LIMEN_FINISH_WEBHOOK_ENV=/srv/limen/projects/rezavo/.limen/finish-webhook.env
#
# Day-one: Grok/Cursor Router wake may still use parent SendToAgent when
# seat webhook is unset. HTTP 2xx ≠ observed bot wake.
